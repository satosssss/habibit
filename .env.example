# Account + AI configuration (sub-project D)
#
# Copy to `.env.local` for local development. Vercel: add the same names under
# Project → Settings → Environment Variables for Production and Preview.

# Auth.js JWT signing. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-side suggestions (Google AI Studio → Get API key). Free tier.
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
